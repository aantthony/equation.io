{
  "name": "equation",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "web": "vite",
    "web:build": "vite build",
    "shots": "node scripts/screenshots.ts",
    "shots:examples": "node scripts/screenshots.ts --examples",
    "icons": "node scripts/icons.ts",
    "plugin:zip": "node scripts/plugin-zip.ts",
    "deploy": "wrangler types && vite build && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p web --noEmit && tsc -p worker --noEmit && tsc -p worker/tsconfig.test.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:objects": "node scripts/objects-test.ts",
    "test:editor": "node scripts/editor-test.ts",
    "test:swipe": "node scripts/swipe-test.ts",
    "test:prod": "vite build && node scripts/prod-test.ts",
    "bench": "vitest bench --run",
    "perf": "node scripts/perf.ts",
    "perf:update": "node scripts/perf.ts --update",
    "traffic": "node scripts/traffic.ts"
  },
  "private": true,
  "license": "MIT",
  "homepage": "https://equation.io/",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4"
  }
}
