{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "binding": "ASSETS",
    // A path with no file gets 404.html and a 404, never the app: the app is
    // served only at / and, by the Worker, at /g/*. A missing hashed bundle
    // 404s too, instead of answering a script request with HTML.
    "not_found_handling": "404-page",
    // EVERY path worker/index.ts handles has to be listed here, including
    // each intent landing (lib/landings.ts landingWorkerPaths). Anything not
    // listed is served by the asset server alone, so a missing entry 404s.
    // lib/deploy-config.test.ts keeps this list in sync with the handler.
    //
    // /llms.txt and /robots.txt are here for a different reason: deployed
    // static assets lose the charset on their Content-Type
    // (cloudflare/workers-sdk#9599), which mangles the em dashes in llms.txt,
    // so the Worker puts it back.
    "run_worker_first": [
      "/.well-known",
      "/.well-known/*",
      "/api",
      "/api/*",
      "/mcp",
      "/mcp/server-card",
      "/g/*",
      "/implicit",
      "/implicit/",
      "/slope-field",
      "/slope-field/",
      "/complex",
      "/complex/",
      "/llms.txt",
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  },
  // The app's one database; tables are prefixed by feature (voice_…: voice
  // mode credit, worker/voice-credit.ts). No database_id: `wrangler deploy`
  // provisions it on first deploy and records the id. Apply the schema with
  // `wrangler d1 migrations apply DB [--remote]`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equation",
      "migrations_dir": "migrations"
    }
  ],
  // MCP tool usage (worker/mcp-usage.ts): tool, client, graph types and row
  // counts, never equation text. Read with scripts/traffic.ts; Analytics
  // Engine keeps three months.
  "analytics_engine_datasets": [
    {
      "binding": "MCP_USAGE",
      "dataset": "equation_mcp"
    }
  ]
}
