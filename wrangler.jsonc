{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // EVERY path worker/index.ts handles has to be listed here, including
    // each intent landing (lib/landings.ts landingWorkerPaths). Anything not
    // listed is served by the asset server alone: with
    // not_found_handling=single-page-application a GET then returns the app
    // shell (HTTP 200!) and a POST returns 405, so a missing entry looks like
    // a half-working route rather than a routing failure. worker/routes.test.ts
    // keeps this list in sync with the handler.
    //
    // /llms.txt and /robots.txt are here for a different reason: deployed
    // static assets lose the charset on their Content-Type
    // (cloudflare/workers-sdk#9599), which mangles the em dashes in llms.txt,
    // so the Worker puts it back.
    "run_worker_first": [
      "/.well-known",
      "/.well-known/*",
      "/api",
      "/api/*",
      "/mcp",
      "/g/*",
      "/implicit",
      "/implicit/",
      "/slope-field",
      "/slope-field/",
      "/complex",
      "/complex/",
      "/llms.txt",
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  },
  // The app's one database; tables are prefixed by feature (voice_…: voice
  // mode credit, worker/voice-credit.ts). No database_id: `wrangler deploy`
  // provisions it on first deploy and records the id. Apply the schema with
  // `wrangler d1 migrations apply DB [--remote]`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equation",
      "migrations_dir": "migrations"
    }
  ],
  // One per live voice call: its metering sideband (worker/voice-call.ts).
  "durable_objects": {
    "bindings": [{ "name": "VOICE_CALLS", "class_name": "VoiceCall" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceCall"] }]
}
